{
  "name": "ecoclasifica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EcoClasifica: PWA para clasificar residuos y darles segunda vida con IA",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "spike:ai": "npm run spike -w backend --"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  }
}
