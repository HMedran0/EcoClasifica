{
  // Autónomo a propósito (ADR-17): Vercel puede construir solo frontend/ y shared/, sin la raíz,
  // y Vite falla si este archivo extiende ../tsconfig.base.json. Mantener en sincronía con él.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src"]
}
