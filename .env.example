# ====== BACKEND (Railway: cargar en el panel de Variables) ======
NODE_ENV=development
PORT=3000

# IA (DeepSeek). `deepseek-flash` tiene visión (verificado en F0, 2026-10-11).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=384
DEEPSEEK_CHAT_MAX_TOKENS=512
DEEPSEEK_TIMEOUT_MS=20000
# Opcional: low (512x512, menos tokens) | auto (original). Vacía → no se envía `detail`.
DEEPSEEK_IMAGE_DETAIL=

# Supabase (la service role key SOLO vive en el servidor; salta RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# CORS: dominios del frontend separados por coma (incluir el dominio de Vercel)
ALLOWED_ORIGINS=http://localhost:5173

# Municipio por defecto para las reglas de contenedores (San Juan Nepomuceno; verificar código DANE)
DEFAULT_MUNICIPALITY_CODE=13657

# ====== FRONTEND (Vercel; frontend/.env.local en desarrollo) ======
# Estas variables se publican en el bundle: nunca pongas secretos aquí.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
