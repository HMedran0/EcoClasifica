# ====== BACKEND (Railway: cargar en el panel de Variables) ======
NODE_ENV=development
PORT=3000

# IA (DeepSeek). `deepseek-flash` tiene visión (verificado en F0, 2026-10-11).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=384
DEEPSEEK_CHAT_MAX_TOKENS=512
DEEPSEEK_TIMEOUT_MS=20000
# Opcional: low (512x512, menos tokens) | auto (original). Vacía → no se envía `detail`.
DEEPSEEK_IMAGE_DETAIL=

# Supabase (la service role key SOLO vive en el servidor; salta RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: orígenes del frontend separados por coma (incluir el dominio de Vercel).
# Obligatoria en producción: cada uno https://dominio exacto, sin / final (http solo para localhost).
ALLOWED_ORIGINS=http://localhost:5173

# Municipio por defecto para las reglas de contenedores (San Juan Nepomuceno; verificar código DANE)
DEFAULT_MUNICIPALITY_CODE=13657

# Cuota diaria de IA (HU-20; el día va de medianoche a medianoche en America/Bogota).
QUOTA_USER_SCANS=60
QUOTA_USER_CHAT=100
QUOTA_ANON_SCANS=30
QUOTA_ANON_CHAT=60
AI_DAILY_TOKEN_CAP=1000000
# Sin sesión se corta al llegar a esta fracción del tope (el resto queda para quien tiene cuenta).
AI_ANON_TOKEN_SHARE=0.7
# Sal del hash de la IP de los anónimos. Obligatoria en producción (≥ 32 caracteres):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# ====== FRONTEND (Vercel; frontend/.env.local en desarrollo) ======
# Estas variables se publican en el bundle: nunca pongas secretos aquí.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
